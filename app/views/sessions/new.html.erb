<main class="container py-5">
  <div class="mx-auto" style="max-width: 400px;">
    <h1 class="text-center mb-4"><%= t('common.login') %></h1>

    <div class="mb-3">
      <label for="email" class="form-label"><%= t('common.email') %></label>
      <input type="email" id="email" class="form-control" disabled>
    </div>

    <div class="mb-3">
      <label for="password" class="form-label"><%= t('common.password') %></label>
      <input type="password" id="password" class="form-control" disabled>
    </div>

    <button type="button" class="btn btn-primary w-100" disabled>
      <%= t('common.login') %>
    </button>

    <p class="text-muted text-center mt-3">
      ※現在は仮画面です。
    </p>
  </div>
</main>