<main class="container py-5">
  <h1 class="text-center mb-4"><%= t("wine_records.index.title") %></h1>

  <%# Issue #33でDBから取得したデータに置き換える %>
  <div class="p-3 mb-3" style="background-color: #ffe5e5;">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="fs-5 fw-bold mb-0">カベルネ・フラン</h2>
      <span class="small">2026/11/13</span>
    </div>

  <div class="d-flex flex-wrap align-items-center gap-2">
    <span class="badge border text-dark bg-white">
    <%= t("wine_records.form.acidity") %>：<%= t("wine_records.options.acidity.high") %>
    </span>
    <span class="badge border text-dark bg-white">
    <%= t("wine_records.form.tannin") %>：<%= t("wine_records.options.tannin.high") %>
    </span>
    <span class="badge border text-dark bg-white">
    <%= t("wine_records.form.sweetness") %>：<%= t("wine_records.options.sweetness.dry") %>
    </span>
    <span class="badge border text-dark bg-white">
    <%= t("wine_records.form.satisfaction") %>：<%= t("wine_records.options.satisfaction.high") %>
    </span>

      <div class="ms-auto d-flex gap-2">
        <button type="button" class="btn btn-danger btn-sm" disabled>
          <i class="bi bi-pencil"></i> <%= t("common.edit") %>
        </button>
        <button type="button" class="btn btn-danger btn-sm" disabled>
          <i class="bi bi-trash"></i> <%= t("common.delete") %>
        </button>
      </div>
    </div>
  </div>
</main>
