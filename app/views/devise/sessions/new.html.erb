<h2><%= t("common.login") %></h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <p><%= f.label :email, t("common.email") %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password, t("common.password") %></p>
    <p><%= f.password_field :password, autocomplete: "current-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit t("common.login") %>
  </div>
<% end %>

<%= render "users/shared/links" %>
