<main class="d-flex align-items-center justify-content-center text-center"
      style="min-height: 75vh;
             background-image: linear-gradient(rgba(0,0,0,0.35), rgba(0,0,0,0.35)), url('<%= asset_path("wine-background.jpg") %>');
             background-size: cover;
             background-position: center;">

  <div class="text-white px-3">
    <h1 class="display-4 fw-bold mb-4">Wine Record</h1>

    <p class="lead">
      自分だけのワインノートを作ろう。
    </p>

    <p>
      ワインの酸味・タンニン・甘辛・満足度を記録できます。
    </p>

    <% unless user_signed_in? %>
      <%= link_to t("common.login"), new_user_session_path, class: "btn btn-danger mt-3" %>
    <% end %>
  </div>
</main>